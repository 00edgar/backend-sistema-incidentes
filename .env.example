# Copiar a ".env" en la raiz del repositorio y completar. NUNCA subir ".env" a GitHub.

# ---- Backend (Express) ----
PUERTO_BACKEND=3000
# Direccion donde se sirve el repositorio del frontend (CORS)
ORIGEN_PERMITIDO_FRONTEND=http://localhost:5500

# ---- PostgreSQL (instalacion local) ----
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/incidentes?schema=public

# ---- n8n (instalacion local) ----
N8N_URL_WEBHOOK_ASISTENTE_RAG=http://localhost:5678/webhook/asistencia-rag
N8N_URL_WEBHOOK_INDEXACION=http://localhost:5678/webhook/indexacion-articulos
N8N_TOKEN_SECRETO=cambiar-por-un-valor-secreto
N8N_TIMEOUT_MILISEGUNDOS=30000

# ---- Asistente RAG ----
UMBRAL_SIMILITUD=0.6
LIMITE_MINIMO_FUENTES=3
LIMITE_MAXIMO_FUENTES=5

# ---- Variables que usa n8n (no el backend) ----
QDRANT_URL=http://localhost:6333
QDRANT_COLECCION=articulosConocimiento
PROVEEDOR_IA_URL_BASE=http://localhost:11434
PROVEEDOR_IA_API_KEY=
PROVEEDOR_IA_MODELO_EMBEDDINGS=nombre-del-modelo-de-embeddings
PROVEEDOR_IA_MODELO_GENERACION=nombre-del-modelo-de-generacion
